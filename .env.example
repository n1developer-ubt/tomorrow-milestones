# Copy to .env.local and fill in real values.

# LLM (provider-neutral; supported providers: openai)
LLM_PROVIDER=openai
LLM_MAX_OUTPUT_TOKENS=2000
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1
LLM_MAX_VALIDATION_ATTEMPTS=2

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-5-nano
OPENAI_REASONING_EFFORT=minimal

# MongoDB (Atlas or local)
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net
MONGODB_DB=tomorrow_milestones

# Basic auth: enforced when both are set (required in production)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change-me
